{
  "name": "dsh-theme-rhine-lab",
  "version": "0.1.0",
  "description": "Arknights Rhine Lab (莱茵生命) skin for the DeepSeek Harness Web GUI: a token override layer plus holographic decorations, toggled by a General-settings row",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsdown"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "theme",
    "skin",
    "arknights",
    "rhine-lab"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
